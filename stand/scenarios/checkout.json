                            "timeout_ms": 250,
                            "max_attempts": 1,
                            "backoff_ms": 0,
                            "retry_on": [
                                "5xx",
                                "timeout"
                            ],
                            "required": true
                        },
                        "pricing-quote": {
                            "target": {
                                "service_id": "pricing",
                                "method": "GET",
                                "route": "/quote"
