                            ],
                            "required": true
                        }
                    },
                    "steps": [
                        {
                            "id": "order",
                            "call": "orders-create"
                        }
                    ]
                },
                "POST /refund": {
                    "work": {
                        "kind": "fixed",
                        "delay_ms": 4
                    },
                    "calls": {
                        "orders-refund": {
                            "target": {
                                "service_id": "orders",
                                "method": "POST",
                                "route": "/refund"
